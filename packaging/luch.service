[Unit]
Description=Luch minimal Wayland launcher
Documentation=file://@ROOT@/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart="@ROOT@/bin/luch" daemon
Restart=on-failure
RestartSec=1
Environment=GDK_BACKEND=wayland
# Launched desktop apps outlive the launcher; SIGTERM cancels active shell work.
KillMode=process

[Install]
WantedBy=default.target
